{
  "name": "over-strudel",
  "version": "0.1.0",
  "description": "Live-code music with Strudel and watch it become sheet music in real time. Edit the score and the code rewrites itself.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/crm107-ua/over-strudel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crm107-ua/over-strudel.git"
  },
  "bugs": {
    "url": "https://github.com/crm107-ua/over-strudel/issues"
  },
  "keywords": [
    "strudel",
    "live-coding",
    "music-notation",
    "sheet-music",
    "vexflow",
    "nextjs",
    "monaco-editor",
    "algorithmic-music"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/editor.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@monaco-editor/react": "^4.7.0",
    "@strudel/core": "^1.2.6",
    "@strudel/mini": "^1.2.6",
    "@strudel/tonal": "^1.2.6",
    "@strudel/transpiler": "^1.2.6",
    "@strudel/web": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vexflow": "^5.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
